#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
// Scroll speed. The scroll behavior moves every 16 ms and drops fractions, so
// 140/s gives two notches per dial click (see tap-ms on scroll_encoder).
#define ZMK_POINTING_DEFAULT_SCRL_VAL 140   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

// Layers. Order matters: a higher number wins when several are active.
#define BASE    0
#define MAC     1   // Mac mode: Windows-style Ctrl/Alt shortcuts, right Alt is Accent
#define FN      2   // left Fn thumb
#define FN_MAC  3   // Fn while in Mac mode
#define ACC_MAC 4   // right Alt in Mac mode
#define SYSTEM  5   // hold Fn, then hold Space
#define MOUSE   6   // joystick click toggles

// In Mac mode the Ctrl keys send left Cmd and the Alt key sends right Cmd,
// so the two can be told apart below.
#define CTRL_HELD (MOD_LGUI)
#define ALT_HELD  (MOD_RGUI)

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

// Mac accents: Option+<dead key>, then the letter. Shift gives the capital.
#define MAC_ACCENT(name, dead, key) \
    name##_lo: name##_lo { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        bindings = <&macro_tap &kp dead &kp key>; \
    }; \
    name##_up: name##_up { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        bindings = <&macro_tap &kp dead &kp LS(key)>; \
    }; \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <&name##_lo>, <&name##_up>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    };

// Sends `morphed` instead of `normal` while one of `mods` is held
// (the held modifier is not sent along with it).
#define MORPH(name, normal, morphed, held) \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <normal>, <morphed>; \
        mods = <held>; \
    };

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        vol_encoder: vol_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        MAC_ACCENT(mac_a, LA(E), A)
        MAC_ACCENT(mac_e, LA(E), E)
        MAC_ACCENT(mac_i, LA(E), I)
        MAC_ACCENT(mac_o, LA(E), O)
        MAC_ACCENT(mac_u, LA(E), U)
        MAC_ACCENT(mac_n, LA(N), N)
        MAC_ACCENT(mac_y, LA(U), U)

        // Mac mode keys that act like Windows shortcuts.
        MORPH(m_tab,   &kp TAB,       &kp LC(TAB),   CTRL_HELD)  // Ctrl+Tab: next tab
        MORPH(m_left,  &kp LEFT,      &kp LA(LEFT),  CTRL_HELD)  // Ctrl+arrow: by word
        MORPH(m_right, &kp RIGHT,     &kp LA(RIGHT), CTRL_HELD)
        MORPH(m_up,    &kp UP,        &kp LA(UP),    CTRL_HELD)
        MORPH(m_down,  &kp DOWN,      &kp LA(DOWN),  CTRL_HELD)
        MORPH(m_bspc,  &kp BSPC,      &kp LA(BSPC),  CTRL_HELD)  // delete word
        MORPH(m_del,   &kp DEL,       &kp LA(DEL),   CTRL_HELD)
        MORPH(m_home,  &kp LG(LEFT),  &kp LG(UP),    CTRL_HELD)  // line / document start
        MORPH(m_end,   &kp LG(RIGHT), &kp LG(DOWN),  CTRL_HELD)
        MORPH(m_f4,    &kp F4,        &kp LG(Q),     ALT_HELD)   // Alt+F4: quit app

        mac_on: mac_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        mac_off: mac_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    combos {
        compatible = "zmk,combos";

        // Hold Q+S+Z for 2 s: deep sleep. Press reset to wake.
        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        // Brackets: press both keys together. Only on the base layer (and Mac
        // mode), only if both go down within 30 ms, and not mid-typing.
        lbkt {  // E+R
            bindings = <&kp LBKT>;
            key-positions = <16 17>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
        rbkt {  // U+I
            bindings = <&kp RBKT>;
            key-positions = <21 22>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
        lpar {  // D+F
            bindings = <&kp LPAR>;
            key-positions = <29 30>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
        rpar {  // J+K
            bindings = <&kp RPAR>;
            key-positions = <34 35>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
        lbrc {  // C+V
            bindings = <&kp LBRC>;
            key-positions = <42 43>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
        rbrc {  // M+,
            bindings = <&kp RBRC>;
            key-positions = <47 48>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
        bslh {  // T+Y
            bindings = <&kp BSLH>;
            key-positions = <18 20>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
        pipe {  // G+H
            bindings = <&kp PIPE>;
            key-positions = <31 33>;
            layers = <BASE MAC>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Right Alt is AltGr: with Windows "United States-International" or
        // Linux "English (US, intl., with AltGr dead keys)" it types
        // á é í ó ú ñ ü ¡ ¿ (RAlt + a e i o u n y 1 /).
        base {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1    &kp N2    &kp N3     &kp N4     &kp N5     &kp UP          &kp N6     &kp N7     &kp N8      &kp N9     &kp N0     &kp MINUS
&kp TAB     &kp Q     &kp W     &kp E      &kp R      &kp T      &kp DOWN        &kp Y      &kp U      &kp I       &kp O      &kp P      &kp BSLH
&kp ESC     &kp A     &kp S     &kp D      &kp F      &kp G      &kp LEFT        &kp H      &kp J      &kp K       &kp L      &kp SEMI   &kp SQT
&kp LSHFT   &kp Z     &kp X     &kp C      &kp V      &kp B      &kp RIGHT       &kp N      &kp M      &kp COMMA   &kp DOT    &kp FSLH   &kp RSHFT
&kp C_MUTE  &kp LGUI  &kp LALT  &kp LCTRL  &mo FN     &kp BSPC   &tog MOUSE      &kp ENTER  &kp SPACE  &kp RCTRL   &kp RALT   &kp RGUI
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        // Mac mode: Ctrl and Alt send Cmd (Ctrl+C, Alt+Tab work as on Windows),
        // left Win is the Mac's Ctrl, right Win is Option, right Alt is Accent.
        mac {
            display-name = "Mac";
            bindings = <
&trans   &trans     &trans     &trans     &trans  &trans   &m_up     &trans  &trans  &trans     &trans       &trans    &trans
&m_tab   &trans     &trans     &trans     &trans  &trans   &m_down   &trans  &trans  &trans     &trans       &trans    &trans
&trans   &trans     &trans     &trans     &trans  &trans   &m_left   &trans  &trans  &trans     &trans       &trans    &trans
&trans   &trans     &trans     &trans     &trans  &trans   &m_right  &trans  &trans  &trans     &trans       &trans    &trans
&trans   &kp LCTRL  &kp RGUI   &kp LGUI   &trans  &m_bspc  &trans    &trans  &trans  &kp LGUI   &mo ACC_MAC  &kp LALT
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1     &kp F2  &kp F3          &kp F4          &kp F5      &kp F6    &trans  &kp F7     &kp F8      &kp F9    &kp F10    &kp F11   &kp F12
&trans     &trans  &kp C_PREV      &kp C_PP        &kp C_NEXT  &trans    &trans  &kp PG_UP  &kp HOME    &kp UP    &kp END    &kp LBKT  &kp RBKT
&kp CAPS   &trans  &kp C_BRI_DN    &kp C_BRI_UP    &trans      &trans    &trans  &kp PG_DN  &kp LEFT    &kp DOWN  &kp RIGHT  &trans    &kp GRAVE
&trans     &trans  &trans          &trans          &trans      &trans    &trans  &trans     &trans      &trans    &trans     &trans    &trans
&trans     &trans  &trans          &trans          &trans      &kp DEL   &trans  &trans     &mo SYSTEM  &trans    &trans     &trans
            >;
            sensor-bindings = <&vol_encoder>;
        };

        fn_mac {
            display-name = "Fn";
            bindings = <
&trans  &trans  &trans  &m_f4   &trans  &trans  &trans  &trans  &trans   &trans  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m_home  &m_up   &m_end    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &m_left  &m_down &m_right  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &m_del  &trans  &trans  &trans   &trans  &trans    &trans
            >;
            sensor-bindings = <&vol_encoder>;
        };

        accent_mac {
            display-name = "Accent";
            bindings = <
&trans  &kp LA(N1)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans
&trans  &trans      &trans  &mac_e  &trans  &trans  &trans  &mac_y  &mac_u  &mac_i  &mac_o  &trans            &trans
&trans  &mac_a      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &mac_n  &trans  &trans  &trans  &kp LA(LS(FSLH))  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // M = Mac mode, W = Windows/Linux mode.
        system {
            display-name = "System";
            bindings = <
&bootloader  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4  &trans  &trans  &trans       &trans  &trans  &trans  &bootloader
&bt BT_CLR   &trans           &mac_off MAC     &trans           &trans           &trans        &trans  &trans  &trans       &trans  &trans  &trans  &trans
&trans       &out OUT_USB     &out OUT_BLE     &trans           &trans           &trans        &trans  &trans  &trans       &trans  &trans  &trans  &trans
&trans       &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans        &trans  &trans  &mac_on MAC  &trans  &trans  &trans  &trans
&trans       &trans           &trans           &trans           &trans           &trans        &trans  &trans  &trans       &trans  &trans  &trans
            >;
            sensor-bindings = <&rgb_encoder>;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_UP     &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_DOWN   &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_LEFT   &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_RIGHT  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &tog MOUSE       &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fn_mac {
            if-layers = <FN MAC>;
            then-layer = <FN_MAC>;
        };
    };
};
