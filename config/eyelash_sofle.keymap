#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

// Layers. Order matters: a higher number wins when several are active.
#define BASE    0
#define FN_L    1   // left Fn thumb
#define FN_R    2   // right Fn thumb (same keys as FN_L)
#define ACCENT  3   // Accent thumb, PC mode: sends AltGr+letter
#define MAC     4   // empty; toggled on System+M to switch accents to Mac mode
#define ACC_MAC 5   // Accent thumb while MAC is on
#define SYSTEM  6   // both Fn thumbs held
#define MOUSE   7   // joystick click toggles

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

// Mac accents: Option+<dead key>, then the letter. Shift gives the capital.
#define MAC_ACCENT(name, dead, key) \
    name##_lo: name##_lo { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        bindings = <&macro_tap &kp dead &kp key>; \
    }; \
    name##_up: name##_up { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        bindings = <&macro_tap &kp dead &kp LS(key)>; \
    }; \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <&name##_lo>, <&name##_up>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    };

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <30>;
        };

        vol_encoder: vol_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        MAC_ACCENT(mac_a, LA(E), A)
        MAC_ACCENT(mac_e, LA(E), E)
        MAC_ACCENT(mac_i, LA(E), I)
        MAC_ACCENT(mac_o, LA(E), O)
        MAC_ACCENT(mac_u, LA(E), U)
        MAC_ACCENT(mac_n, LA(N), N)
        MAC_ACCENT(mac_y, LA(U), U)
    };

    combos {
        compatible = "zmk,combos";

        // Hold Q+S+Z for 2 s: deep sleep. Press reset to wake.
        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

// Shared by both Fn layers.
#define FN_BINDINGS \
&kp F1     &kp F2  &kp F3          &kp F4          &kp F5      &kp F6    &trans  &kp F7     &kp F8    &kp F9    &kp F10    &kp F11   &kp F12 \
&trans     &trans  &kp C_PREV      &kp C_PP        &kp C_NEXT  &trans    &trans  &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp LBKT  &kp RBKT \
&kp CAPS   &trans  &kp C_BRI_DN    &kp C_BRI_UP    &trans      &trans    &trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans    &kp GRAVE \
&trans     &trans  &trans          &trans          &trans      &trans    &trans  &trans     &trans    &trans    &trans     &trans    &trans \
&trans     &trans  &trans          &trans          &trans      &kp DEL   &trans  &trans     &trans    &trans    &trans     &trans

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1     &kp N2    &kp N3    &kp N4     &kp N5     &kp UP          &kp N6     &kp N7     &kp N8      &kp N9        &kp N0     &kp MINUS
&kp TAB     &kp Q      &kp W     &kp E     &kp R      &kp T      &kp DOWN        &kp Y      &kp U      &kp I       &kp O         &kp P      &kp BSLH
&kp ESC     &kp A      &kp S     &kp D     &kp F      &kp G      &kp LEFT        &kp H      &kp J      &kp K       &kp L         &kp SEMI   &kp SQT
&kp LSHFT   &kp Z      &kp X     &kp C     &kp V      &kp B      &kp RIGHT       &kp N      &kp M      &kp COMMA   &kp DOT       &kp FSLH   &kp RSHFT
&kp C_MUTE  &kp LCTRL  &kp LALT  &kp LGUI  &mo FN_L   &kp BSPC   &tog MOUSE      &kp SPACE  &kp ENTER  &mo FN_R    &mo ACCENT    &kp RCTRL
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        fn_left {
            display-name = "Fn";
            bindings = <FN_BINDINGS>;
            sensor-bindings = <&vol_encoder>;
        };

        fn_right {
            display-name = "Fn";
            bindings = <FN_BINDINGS>;
            sensor-bindings = <&vol_encoder>;
        };

        // PC mode. Needs Windows "United States-International" or
        // Linux "English (US, intl., with AltGr dead keys)".
        accent {
            display-name = "Accent";
            bindings = <
&trans  &kp RA(N1)  &trans  &trans      &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans        &trans
&trans  &trans      &trans  &kp RA(E)   &trans  &trans  &trans  &kp RA(Y)   &kp RA(U)   &kp RA(I)   &kp RA(O)   &trans        &trans
&trans  &kp RA(A)   &trans  &trans      &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans        &trans
&trans  &trans      &trans  &trans      &trans  &trans  &trans  &kp RA(N)   &trans      &trans      &trans      &kp RA(FSLH)  &trans
&trans  &trans      &trans  &trans      &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans
            >;
        };

        mac {
            display-name = "Mac";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        accent_mac {
            display-name = "Accent";
            bindings = <
&trans  &kp LA(N1)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans
&trans  &trans      &trans  &mac_e  &trans  &trans  &trans  &mac_y  &mac_u  &mac_i  &mac_o  &trans            &trans
&trans  &mac_a      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &mac_n  &trans  &trans  &trans  &kp LA(LS(FSLH))  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        system {
            display-name = "System";
            bindings = <
&bootloader  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4  &trans  &trans  &trans    &trans  &trans  &trans  &bootloader
&bt BT_CLR   &trans           &trans           &trans           &trans           &trans        &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans       &out OUT_USB     &out OUT_BLE     &trans           &trans           &trans        &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans       &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans        &trans  &trans  &tog MAC  &trans  &trans  &trans  &trans
&trans       &trans           &trans           &trans           &trans           &trans        &trans  &trans  &trans    &trans  &trans  &trans
            >;
            sensor-bindings = <&rgb_encoder>;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_UP     &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_DOWN   &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_LEFT   &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &mmv MOVE_RIGHT  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &tog MOUSE       &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system {
            if-layers = <FN_L FN_R>;
            then-layer = <SYSTEM>;
        };

        accent_mac {
            if-layers = <ACCENT MAC>;
            then-layer = <ACC_MAC>;
        };
    };
};
